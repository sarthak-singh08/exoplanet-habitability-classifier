import pandas as pd
import matplotlib.pyplot as plt
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

#Dataset
data = [
    [1.0, 288, 365, 1],
    [6.8, 2600, 0.3, 0],
    [1.1, 290, 370, 1],
    [5.5, 1500, 10, 0],
    [0.9, 280, 360, 1],
    [7.0, 2000, 5, 0]
]

df = pd.DataFrame(data, columns=["radius", "temperature", "orbital_period", "habitable"])

# Features and target
X = df[["radius", "temperature", "orbital_period"]]
y = df["habitable"]

#Train-test split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

# Model training
model = DecisionTreeClassifier()
model.fit(X_train, y_train)

#Evaluation
y_pred = model.predict(X_test)
print("Accuracy:", accuracy_score(y_test, y_pred))

#Prediction example
test = [[1.2, 300, 350]]
prediction = model.predict(test)
print("Prediction (1 = Habitable, 0 = Not Habitable):", prediction[0])

#Visualization 1
df["temperature"].plot(kind="bar")
plt.title("Planet Temperature Comparison")
plt.xlabel("Planet Index")
plt.ylabel("Temperature (K)")
plt.show()

#Visualization 2
df["radius"].plot(kind="hist")
plt.title("Distribution of Planet Radius")
plt.show()
